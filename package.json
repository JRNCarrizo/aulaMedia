{
  "name": "aula-media",
  "version": "1.1.0",
  "description": "App de escritorio para descargar videos, audio y subtítulos de YouTube, pensada para docentes",
  "main": "electron/main.js",
  "author": "JRNCarrizo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JRNCarrizo/aulaMedia.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:installer": "electron-builder --win nsis",
    "icon:round": "node scripts/round-icon.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.1.9"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "youtube-dl-exec@3.1.9": true,
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.aulamedia.app",
    "productName": "Aula Media",
    "copyright": "Copyright © 2026 JRNCarrizo",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/youtube-dl-exec/bin/**"
    ],
    "extraResources": [],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AulaMedia-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aula Media",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "AulaMedia-${version}-portable.${ext}"
    }
  }
}
